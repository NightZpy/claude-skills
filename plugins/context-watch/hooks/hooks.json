{
  "hooks": {
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/context-watch.mjs\" post" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/context-watch.mjs\" prompt" }] }
    ],
    "SessionStart": [
      { "matcher": "clear", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/context-watch.mjs\" start" }] }
    ]
  }
}
